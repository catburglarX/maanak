# Copy to .env and replace every value marked CHANGE-ME.
# Generate secrets with:  openssl rand -base64 48
# or:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Environment ------------------------------------------------------------
# development | test | production
MAANAK_ENV=development

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=maanak
POSTGRES_USER=maanak
POSTGRES_PASSWORD=CHANGE-ME-database-password

# --- Session signing --------------------------------------------------------
# At least 32 characters. JWT_SECRET_PREVIOUS lets you rotate the signing key
# without ending every active session: move the old value here, put the new
# value in JWT_SECRET, restart, then clear this after the access token TTL.
JWT_SECRET=CHANGE-ME-random-secret-at-least-32-characters
JWT_SECRET_PREVIOUS=

# --- Object storage (MinIO locally, any S3-compatible service in production) -
S3_ACCESS_KEY=maanak
S3_SECRET_KEY=CHANGE-ME-object-storage-secret
# Browser-reachable endpoint used when signing evidence URLs.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# Enables encryption at rest in MinIO. Format: <key-name>:<base64 of 32 bytes>.
# Generate the key part with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# In production, use a managed KMS or the storage service's own encryption instead.
MINIO_KMS_SECRET_KEY=maanak-evidence-key:CHANGE-ME-base64-32-byte-key

# --- HTTP -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
PUBLIC_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080/api
# Set true whenever the site is served over HTTPS. Required in production.
COOKIE_SECURE=false
# Comma-separated hostnames. Must be explicit in production.
TRUSTED_HOSTS=*
# Interactive API docs. Set false in production.
DOCS_ENABLED=true

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=20
